# Plantilla de variables del frontend. Copiala como .env.local y ajustala.
# Este archivo SI se versiona; .env y .env.local no.
#
# URL del backend donde corre la API.
#   - Desarrollo local:  http://localhost:4000
#   - Produccion (Render): https://backend-soporte-campo-vpc.onrender.com
#
# Si no se define, src/config.js usa la URL de produccion como alternativa, que
# es lo que conviene en Render.
VITE_API_BASE_URL=http://localhost:4000
